{
  "name": "wor-flasher",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Native Rust CLI and desktop app for preparing Windows on Raspberry Pi media.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/blackoutsecure/wor-flasher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackoutsecure/wor-flasher.git"
  },
  "bugs": {
    "url": "https://github.com/blackoutsecure/wor-flasher/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Botspot"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/blackoutsecure"
    }
  ],
  "keywords": [
    "raspberry-pi",
    "windows-on-raspberry",
    "wor",
    "flasher",
    "arm64",
    "macos",
    "linux",
    "rust",
    "dioxus"
  ],
  "scripts": {
    "clean": "node src/package-rust.mjs --clean",
    "build:rust": "node src/package-rust.mjs --desktop",
    "build:pi3-boot-refresh": "node src/build-pi3-boot-refresh.mjs",
    "pi3-boot-refresh:check": "node src/build-pi3-boot-refresh.mjs --check",
    "pe:check": "node src/check-pe-installer.mjs --check",
    "pe:update": "node src/check-pe-installer.mjs --write-latest",
    "metadata:check": "node src/sync-package-metadata.mjs --check",
    "metadata:write": "node src/sync-package-metadata.mjs --write",
    "version:set": "node src/set-version.mjs",
    "test": "npm run test:visual && npm run test:node",
    "test:node": "node --test tests/*.test.mjs",
    "test:visual": "node src/test-ui.mjs",
    "check": "node --check src/build-pi3-boot-refresh.mjs && node --check src/package-rust.mjs && node --check src/check-pe-installer.mjs && node --check src/sync-package-metadata.mjs && node --check src/set-version.mjs && node --check src/test-ui.mjs && node --check src/lib/node-runtime.mjs && node --test tests/*.test.mjs && node src/sync-package-metadata.mjs --check && node src/build-pi3-boot-refresh.mjs --check && node src/check-pe-installer.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
