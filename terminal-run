#!/bin/bash

#$1 is the command to be run.
#$2 is the title.
commands="$1"
title="$2"

#set DEBUG variable to 1 to display which terminal is being used
[ -z "$DEBUG" ] && DEBUG=0

#seconds to wait for the terminal to start before giving up
[ -z "$TERMINAL_TIMEOUT" ] && TERMINAL_TIMEOUT=15

error() {
  echo -e "\e[91m$1\e[39m" 1>&2
  exit 1
}

resolve_path() {
  if command -v realpath >/dev/null ;then
    realpath "$1"
  elif readlink -f "$1" >/dev/null 2>&1 ;then
    readlink -f "$1"
  else
    printf '%s\n' "$1"
  fi
}

#a private directory keeps the pid file path unpredictable to other local users
temp_pid_dir="$(mktemp -d)" || error "terminal-run: failed to create a temporary directory."
temp_pid_file="$temp_pid_dir/pid"
trap 'rm -rf "$temp_pid_dir"' EXIT

#prepend a line that records the terminal's PID so this script can wait for it
commands="echo "\$""\$" > $temp_pid_file
$commands"

if command -v lxterminal >/dev/null ;then
  lxterminal --title="$title" -e bash -c "$commands" &
  [ $DEBUG == 1 ] && echo lxterminal

elif command -v xfce4-terminal >/dev/null ;then
  xfce4-terminal --title="$title" -x bash -c "$commands" &
  [ $DEBUG == 1 ] && echo xfce4-terminal

elif command -v mate-terminal >/dev/null ;then
  mate-terminal --title="$title" -x bash -c "$commands" &
  [ $DEBUG == 1 ] && echo mate-terminal

elif command -v xterm >/dev/null ;then
  xterm -T "$title" -e bash -c "$commands" &
  [ $DEBUG == 1 ] && echo xterm

elif command -v konsole >/dev/null ;then
  konsole -p tabtitle="$title" -e bash <(echo "$commands") &
  [ $DEBUG == 1 ] && echo konsole

elif command -v terminator >/dev/null ;then
  terminator -T "$title" -x bash -c "$commands" &
  [ $DEBUG == 1 ] && echo terminator

elif command -v gnome-terminal >/dev/null ;then
  #gnome-terminal removed -x in favour of --
  gnome-terminal --title="$title" -- bash -c "$commands" &
  [ $DEBUG == 1 ] && echo gnome-terminal

elif command -v qterminal >/dev/null ;then
  qterminal -e bash <(echo "$commands") &
  [ $DEBUG == 1 ] && echo qterminal

elif command -v x-terminal-emulator >/dev/null ;then
  "$(resolve_path "$(command -v x-terminal-emulator)")" -e bash -c "$commands" &
  [ $DEBUG == 1 ] && echo x-terminal-emulator

else
  error "terminal-run: Failed to locate any terminal emulators!"
fi

#A terminal should now be launching and in a few seconds the pid file should appear
if [ ! -z "$temp_pid_file" ];then
  attempts=0
  while [ ! -f "$temp_pid_file" ];do

    if [ "$attempts" -gt "$TERMINAL_TIMEOUT" ];then
      error "terminal-run: No terminal detected as it never created the pid file within $TERMINAL_TIMEOUT seconds."
    fi
    sleep 1
    attempts=$((attempts + 1))
  done #pid file now exists
  terminalrun_pid="$(cat "$temp_pid_file")"

  #now, wait until the pid stops (terminal closes)
  while [ -d /proc/${terminalrun_pid} ];do
    sleep 1
  done

fi









