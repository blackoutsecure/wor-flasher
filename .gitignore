# install-wor.sh creates this next to the scripts to cache worproject.com responses
cache/
wget-log*

# Run logs. WOR_LOG_FILE defaults under DL_DIR/logs, but that can be pointed anywhere
*.log

# Working directory for tests/run-tests.sh: loopback disk images and downloads
.test-workspace/

# Generated release staging output
release/

# User local configuration
config.json
*.config.json
!config-templates/*.config.json
!config-templates/*.json

# Local developer environment: Python virtualenv used by the test tooling, and
# editor state. VS Code writes .vscode/settings.json pointing at this machine's
# interpreter, so it is machine-specific rather than shared project config.
.venv/
.vscode/

# Downloaded components, if DL_DIR is pointed inside the repo
peinstaller/
driverpackage/
pi[345]-uefipackage/
winfiles_*/
*.zip
*.iso
*.ISO
*.esd
*.ESD
*.wim
*.WIM

# OS clutter
.DS_Store
._*
Thumbs.db
