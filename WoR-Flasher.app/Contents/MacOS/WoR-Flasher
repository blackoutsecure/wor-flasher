#!/bin/bash

#Native macOS launcher for the WoR-Flasher GUI and engine.
#A source checkout uses its canonical files directly. A distributed app validates its immutable
#embedded runtime and any verified runtime installed under Application Support before execution.

set -u

LAUNCHER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
APP_CONTENTS="$(cd "$LAUNCHER_DIR/.." && pwd -P)"
APP_ROOT="$(cd "$APP_CONTENTS/.." && pwd -P)"
CHECKOUT_DIR="$(cd "$APP_ROOT/.." && pwd -P)"
INFO_PLIST="${WOR_APP_INFO_PLIST:-$APP_CONTENTS/Info.plist}"
RESOURCES_DIR="${WOR_APP_RESOURCES_DIR:-$APP_CONTENTS/Resources}"
EMBEDDED_RUNTIME="$RESOURCES_DIR/runtime"
EMBEDDED_MANIFEST="$RESOURCES_DIR/runtime-manifest.json"
APP_SUPPORT_DIR="${WOR_APP_SUPPORT_DIR:-$HOME/Library/Application Support/WoR-Flasher}"
RUNTIMES_DIR="$APP_SUPPORT_DIR/runtimes"
ACTIVE_RUNTIME_FILE="$APP_SUPPORT_DIR/active-runtime"
PREVIOUS_RUNTIME_FILE="$APP_SUPPORT_DIR/previous-runtime"
REPO_DIR=''
GUI_SCRIPT=''
METADATA_FILE=''
DEPENDENCIES_FILE=''
RUNTIME_MANIFEST=''
SOURCE_CHECKOUT=0
WOR_FLASHER_NAME="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$INFO_PLIST" 2>/dev/null || printf 'WoR-Flasher')"
BUNDLE_ICON_FILENAME="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$INFO_PLIST" 2>/dev/null || printf 'WoR-Flasher.icns')"
STARTUP_STATUS=''
STARTUP_DONE=''
STARTUP_PID=''

set_runtime_paths() { #Input: runtime root and manifest.
  REPO_DIR="$1"
  RUNTIME_MANIFEST="$2"
  GUI_SCRIPT="$REPO_DIR/install-wor-gui.sh"
  METADATA_FILE="$REPO_DIR/src/lib/metadata.sh"
  DEPENDENCIES_FILE="$REPO_DIR/src/lib/dependencies.sh"
}

manifest_version() { #Input: manifest. Output: declared version.
  sed -n 's/^[[:space:]]*"version": "\([^"]*\)",*[[:space:]]*$/\1/p' "$1" | head -n1
}

version_is_newer() { #Input: candidate and current numeric release versions.
  local candidate="$1"
  local current="$2"
  local candidate_part current_part index
  case "$candidate:$current" in
    *[!0-9.:]*) return 1 ;;
  esac
  for index in 1 2 3 4 ;do
    candidate_part="$(printf '%s' "$candidate" | cut -d. -f"$index")"
    current_part="$(printf '%s' "$current" | cut -d. -f"$index")"
    candidate_part="${candidate_part:-0}"
    current_part="${current_part:-0}"
    [ "$candidate_part" -gt "$current_part" ] && return 0
    [ "$candidate_part" -lt "$current_part" ] && return 1
  done
  return 1
}

validate_runtime() { #Input: runtime root and manifest. Output: success for a complete verified runtime.
  local runtime_root="$1"
  local manifest="$2"
  local line path expected_mode expected_digest actual_mode actual_digest count=0
  [ -d "$runtime_root" ] && [ -f "$manifest" ] || return 1
  [ -n "$(manifest_version "$manifest")" ] || return 1
  while IFS= read -r line ;do
    path="$(printf '%s\n' "$line" | sed -n 's/^[[:space:]]*{"path": "\([^"]*\)", "sha256": "[^"]*", "mode": "[^"]*"},*[[:space:]]*$/\1/p')"
    [ -n "$path" ] || continue
    case "/$path/" in
      /*/../*|/*/./*|//*|/*\\*) return 1 ;;
    esac
    expected_digest="$(printf '%s\n' "$line" | sed -n 's/.*"sha256": "\([0-9a-f]*\)".*/\1/p')"
    expected_mode="$(printf '%s\n' "$line" | sed -n 's/.*"mode": "\([0-7]*\)".*/\1/p')"
    [ -f "$runtime_root/$path" ] && [ ! -L "$runtime_root/$path" ] || return 1
    actual_digest="$(shasum -a 256 "$runtime_root/$path" | awk '{print $1}')"
    if stat -f '%Lp' "$runtime_root/$path" >/dev/null 2>&1 ;then
      actual_mode="$(stat -f '%Lp' "$runtime_root/$path")"
    else
      actual_mode="$(stat -Lc '%a' "$runtime_root/$path")"
    fi
    [ "$actual_digest" == "$expected_digest" ] && [ "$actual_mode" == "$expected_mode" ] || return 1
    count=$((count + 1))
  done < "$manifest"
  [ "$count" -gt 0 ] \
    && [ -x "$runtime_root/install-wor.sh" ] \
    && [ -x "$runtime_root/install-wor-gui.sh" ] \
    && [ -r "$runtime_root/src/lib/metadata.sh" ] \
    && [ -r "$runtime_root/src/lib/dependencies.sh" ]
}

runtime_from_pointer() { #Input: pointer file. Output: runtime and manifest separated by a tab.
  local pointer="$1"
  local version runtime manifest
  [ -f "$pointer" ] || return 1
  IFS= read -r version < "$pointer"
  case "$version" in
    ''|*/*|*\\*|.|..) return 1 ;;
  esac
  runtime="$RUNTIMES_DIR/$version/runtime"
  manifest="$RUNTIMES_DIR/$version/runtime-manifest.json"
  validate_runtime "$runtime" "$manifest" || return 1
  printf '%s\t%s\n' "$runtime" "$manifest"
}

select_runtime() {
  local selected
  if [ -d "$CHECKOUT_DIR/.git" ] && [ -x "$CHECKOUT_DIR/install-wor-gui.sh" ];then
    SOURCE_CHECKOUT=1
    set_runtime_paths "$CHECKOUT_DIR" ''
    return 0
  fi
  selected="$(runtime_from_pointer "$ACTIVE_RUNTIME_FILE" 2>/dev/null)" \
    || selected="$(runtime_from_pointer "$PREVIOUS_RUNTIME_FILE" 2>/dev/null)" \
    || selected=''
  if [ -n "$selected" ];then
    set_runtime_paths "${selected%%$'\t'*}" "${selected#*$'\t'}"
    return 0
  fi
  validate_runtime "$EMBEDDED_RUNTIME" "$EMBEDDED_MANIFEST" || return 1
  set_runtime_paths "$EMBEDDED_RUNTIME" "$EMBEDDED_MANIFEST"
}

write_runtime_pointer() { #Input: pointer path and version.
  local pointer="$1"
  local version="$2"
  local temporary
  mkdir -p "$APP_SUPPORT_DIR"
  temporary="$(mktemp "$APP_SUPPORT_DIR/.runtime-pointer.XXXXXX")" || return 1
  printf '%s\n' "$version" > "$temporary"
  mv -f "$temporary" "$pointer"
}

activate_runtime() { #Input: version. Preserve the formerly active version for rollback.
  local version="$1"
  local active=''
  if [ -f "$ACTIVE_RUNTIME_FILE" ];then
    IFS= read -r active < "$ACTIVE_RUNTIME_FILE"
  fi
  if [ -n "$active" ] && [ "$active" != "$version" ];then
    write_runtime_pointer "$PREVIOUS_RUNTIME_FILE" "$active" || return 1
  fi
  write_runtime_pointer "$ACTIVE_RUNTIME_FILE" "$version"
}

install_staged_runtime() { #Input: staged version directory. Validate and promote atomically.
  local staged="$1"
  local version target
  version="$(manifest_version "$staged/runtime-manifest.json")"
  case "$version" in
    ''|*/*|*\\*|.|..) return 1 ;;
  esac
  validate_runtime "$staged/runtime" "$staged/runtime-manifest.json" || return 1
  target="$RUNTIMES_DIR/$version"
  if [ -e "$target" ];then
    validate_runtime "$target/runtime" "$target/runtime-manifest.json" || return 1
    rm -rf "$staged"
  else
    mv "$staged" "$target" || return 1
  fi
  activate_runtime "$version"
}

bootstrap_embedded_runtime() {
  local version target staged selected
  version="$(manifest_version "$EMBEDDED_MANIFEST")"
  target="$RUNTIMES_DIR/$version"
  if validate_runtime "$target/runtime" "$target/runtime-manifest.json" 2>/dev/null ;then
    selected="$(runtime_from_pointer "$ACTIVE_RUNTIME_FILE" 2>/dev/null)" || selected=''
    [ -n "$selected" ] || activate_runtime "$version"
    return
  fi
  mkdir -p "$RUNTIMES_DIR"
  staged="$(mktemp -d "$RUNTIMES_DIR/.install.XXXXXX")" || return 1
  cp -R "$EMBEDDED_RUNTIME" "$staged/runtime" \
    && cp "$EMBEDDED_MANIFEST" "$staged/runtime-manifest.json" \
    && install_staged_runtime "$staged" \
    || { rm -rf "$staged"; return 1; }
}

metadata_value() { #Input: JSON metadata path and key. Output: scalar value.
  /usr/bin/plutil -extract "$2" raw -o - "$1" 2>/dev/null
}

archive_entries_are_safe() { #Input: tar.gz archive. Reject links and paths escaping extraction.
  local archive="$1"
  local entry
  tar -tzf "$archive" >/dev/null 2>&1 || return 1
  while IFS= read -r entry ;do
    case "$entry" in
      ''|/*|..|../*|*/../*|*\\*) return 1 ;;
    esac
  done < <(tar -tzf "$archive")
  tar -tvzf "$archive" | awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" { exit 1 }'
}

check_for_runtime_update() {
  local metadata_url="${WOR_UPDATE_METADATA_URL:-https://github.com/blackoutsecure/wor-flasher/releases/latest/download/macos-runtime.json}"
  local curl_bin="${WOR_CURL_BIN:-/usr/bin/curl}"
  local work_dir metadata archive version archive_url expected_digest actual_digest staged current_version
  case "$metadata_url" in
    https://*) ;;
    *) [ "${WOR_ALLOW_INSECURE_UPDATE:-0}" == 1 ] || return 0 ;;
  esac
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/wor-flasher-runtime-update.XXXXXX")" || return 0
  metadata="$work_dir/metadata.json"
  archive="$work_dir/runtime.tar.gz"
  if ! "$curl_bin" --fail --location --silent --show-error --max-time 15 "$metadata_url" -o "$metadata" ;then
    rm -rf "$work_dir"
    return 0
  fi
  version="$(metadata_value "$metadata" version)" || { rm -rf "$work_dir"; return 0; }
  archive_url="$(metadata_value "$metadata" url)" || { rm -rf "$work_dir"; return 0; }
  expected_digest="$(metadata_value "$metadata" sha256)" || { rm -rf "$work_dir"; return 0; }
  current_version="$(manifest_version "$RUNTIME_MANIFEST")"
  version_is_newer "$version" "$current_version" || { rm -rf "$work_dir"; return 0; }
  case "$version" in ''|*/*|*\\*|.|..) rm -rf "$work_dir"; return 0 ;; esac
  case "$archive_url" in
    https://*) ;;
    *) [ "${WOR_ALLOW_INSECURE_UPDATE:-0}" == 1 ] || { rm -rf "$work_dir"; return 0; } ;;
  esac
  printf '%s' "$expected_digest" | grep -Eq '^[0-9a-f]{64}$' || { rm -rf "$work_dir"; return 0; }
  ask_to_continue "WoR-Flasher $version is available as a verified runtime update." 'Update Now' \
    || { rm -rf "$work_dir"; return 0; }
  if ! "$curl_bin" --fail --location --silent --show-error --max-time 120 "$archive_url" -o "$archive" ;then
    rm -rf "$work_dir"
    return 0
  fi
  actual_digest="$(shasum -a 256 "$archive" | awk '{print $1}')"
  [ "$actual_digest" == "$expected_digest" ] && archive_entries_are_safe "$archive" \
    || { rm -rf "$work_dir"; return 0; }
  mkdir -p "$RUNTIMES_DIR"
  staged="$(mktemp -d "$RUNTIMES_DIR/.install.XXXXXX")" || { rm -rf "$work_dir"; return 0; }
  if tar -xzf "$archive" -C "$staged" \
    && [ "$(manifest_version "$staged/runtime-manifest.json")" == "$version" ] \
    && install_staged_runtime "$staged" ;then
    rm -rf "$work_dir"
    return 0
  fi
  rm -rf "$staged" "$work_dir"
  return 0
}

start_startup_window() {
  local icon_path="$RESOURCES_DIR/$BUNDLE_ICON_FILENAME"
  rm -f "$STARTUP_DONE"
  /usr/bin/osascript -l JavaScript - "$STARTUP_STATUS" "$STARTUP_DONE" "$WOR_FLASHER_NAME" "$icon_path" <<'JXA' >/dev/null 2>&1 &
ObjC.import('AppKit')
ObjC.import('Foundation')
const args = $.NSProcessInfo.processInfo.arguments
const statusPath = ObjC.unwrap(args.objectAtIndex(4))
const donePath = ObjC.unwrap(args.objectAtIndex(5))
const appTitle = ObjC.unwrap(args.objectAtIndex(6))
const iconPath = ObjC.unwrap(args.objectAtIndex(7))
const fm = $.NSFileManager.defaultManager
$.NSProcessInfo.processInfo.processName = appTitle
const app = $.NSApplication.sharedApplication
app.setActivationPolicy($.NSApplicationActivationPolicyRegular)
app.setApplicationIconImage($.NSImage.alloc.initWithContentsOfFile($(iconPath)))

const window = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(
  $.NSMakeRect(0, 0, 440, 150),
  $.NSWindowStyleMaskTitled,
  $.NSBackingStoreBuffered,
  false,
)
window.title = appTitle
window.center

const heading = $.NSTextField.labelWithString('Preparing WoR-Flasher')
heading.font = $.NSFont.boldSystemFontOfSize(17)
heading.frame = $.NSMakeRect(24, 98, 392, 24)
window.contentView.addSubview(heading)

const detail = $.NSTextField.labelWithString('Starting...')
detail.frame = $.NSMakeRect(24, 63, 392, 22)
detail.lineBreakMode = $.NSLineBreakByTruncatingTail
window.contentView.addSubview(detail)

const bar = $.NSProgressIndicator.alloc.initWithFrame($.NSMakeRect(24, 31, 392, 16))
bar.indeterminate = true
bar.style = $.NSProgressIndicatorStyleBar
bar.startAnimation(null)
window.contentView.addSubview(bar)

function readStatus() {
  try {
    const value = $.NSString.stringWithContentsOfFileEncodingError(
      $(statusPath),
      $.NSUTF8StringEncoding,
      undefined,
    )
    return ObjC.unwrap(value) || 'Preparing...'
  } catch (error) {
    return 'Preparing...'
  }
}

ObjC.registerSubclass({
  name: 'WorStartupController',
  superclass: 'NSObject',
  methods: {
    'tick:': {
      types: ['void', ['id']],
      implementation: function () {
        if (fm.fileExistsAtPath($(donePath))) {
          app.terminate(null)
          return
        }
        detail.stringValue = readStatus()
      },
    },
  },
})
const controller = $.WorStartupController.alloc.init
const timer = $.NSTimer.scheduledTimerWithTimeIntervalTargetSelectorUserInfoRepeats(
  0.15,
  controller,
  'tick:',
  null,
  true,
)
window.makeKeyAndOrderFront(null)
app.activateIgnoringOtherApps(true)
app.run
timer.invalidate
JXA
  STARTUP_PID=$!
}

startup_phase() { #Input: status shown in the startup window.
  printf '%s\n' "$1" > "$STARTUP_STATUS"
}

stop_startup_window() {
  touch "$STARTUP_DONE"
  if [ -n "$STARTUP_PID" ];then
    wait "$STARTUP_PID" 2>/dev/null || true
  fi
  STARTUP_PID=''
}

cleanup_startup() {
  stop_startup_window
  rm -f "$STARTUP_STATUS" "$STARTUP_DONE"
}

load_metadata() {
  #shellcheck source=../../../src/lib/metadata.sh
  source "$METADATA_FILE"
  #shellcheck source=../../../src/lib/dependencies.sh
  source "$DEPENDENCIES_FILE"
}

run_apple_script() {
  if declare -F wor_osascript >/dev/null ;then
    wor_osascript "$@"
  else
    /usr/bin/osascript "$@"
  fi
}

sync_bundle_metadata() {
  local key value current logo_source logo_resource icon_resource iconset_root iconset icon_size icon_png
  logo_source="$REPO_DIR/$WOR_ASSETS_DIRNAME/$WOR_LOGO_FILENAME"
  logo_resource="$RESOURCES_DIR/$WOR_LOGO_FILENAME"
  icon_resource="$RESOURCES_DIR/$WOR_ICON_FILENAME"
  [ -f "$logo_source" ] || return 1
  mkdir -p "$RESOURCES_DIR" || return 1
  if [ ! -f "$logo_resource" ] || ! cmp -s "$logo_source" "$logo_resource" ;then
    cp "$logo_source" "$logo_resource" || return 1
  fi
  if [ ! -f "$icon_resource" ] || [ "$logo_source" -nt "$icon_resource" ];then
    iconset_root="$(mktemp -d "${TMPDIR:-/tmp}/wor-flasher-iconset.XXXXXX")" || return 1
    iconset="$iconset_root/wor-flasher.iconset"
    mkdir "$iconset" || return 1
    trap 'rm -rf "$iconset_root"' RETURN
    sips --resampleHeight 440 "$logo_source" --out "$iconset/source.png" >/dev/null || return 1
    sips --padToHeightWidth 512 512 --padColor 000000 "$iconset/source.png" --out "$iconset/icon_512x512.png" >/dev/null || return 1
    rm -f "$iconset/source.png"
    for icon_size in 16 32 128 256 512 ;do
      icon_png="$iconset/icon_${icon_size}x${icon_size}.png"
      sips --resampleHeightWidth "$icon_size" "$icon_size" "$iconset/icon_512x512.png" --out "$icon_png" >/dev/null || return 1
      if [ "$icon_size" != 512 ];then
        local retina_size=$((icon_size * 2))
        sips --resampleHeightWidth "$retina_size" "$retina_size" "$iconset/icon_512x512.png" --out "$iconset/icon_${icon_size}x${icon_size}@2x.png" >/dev/null || return 1
      fi
    done
    sips --resampleHeightWidth 1024 1024 "$iconset/icon_512x512.png" --out "$iconset/icon_512x512@2x.png" >/dev/null || return 1
    iconutil --convert icns --output "$icon_resource" "$iconset" || return 1
    rm -rf "$iconset_root"
    trap - RETURN
  fi
  while IFS=$'\t' read -r key value ;do
    current="$(/usr/libexec/PlistBuddy -c "Print :$key" "$INFO_PLIST" 2>/dev/null)"
    if [ -z "$current" ];then
      /usr/libexec/PlistBuddy -c "Add :$key string $value" "$INFO_PLIST" || return 1
    elif [ "$current" != "$value" ];then
      /usr/libexec/PlistBuddy -c "Set :$key $value" "$INFO_PLIST" || return 1
    fi
  done <<EOF
CFBundleDisplayName	$WOR_FLASHER_NAME
CFBundleExecutable	$WOR_FLASHER_NAME
CFBundleIconFile	$WOR_ICON_FILENAME
CFBundleIconName	$WOR_ICON_NAME
CFBundleName	$WOR_FLASHER_NAME
CFBundleShortVersionString	$WOR_FLASHER_VERSION
CFBundleVersion	$WOR_FLASHER_VERSION
EOF
}

show_error() { #Input: message.
  run_apple_script - "$WOR_FLASHER_NAME" "$1" <<'APPLESCRIPT' >/dev/null
on run argv
  display alert (item 1 of argv) message (item 2 of argv) as critical buttons {"Quit"} default button "Quit"
end run
APPLESCRIPT
}

ask_to_continue() { #Input: message, action label. Exit 0 when accepted.
  local result
  result="$(run_apple_script - "$WOR_FLASHER_NAME" "$1" "$2" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set dialogResult to display dialog (item 2 of argv) with title (item 1 of argv) buttons {"Quit", item 3 of argv} default button (item 3 of argv) cancel button "Quit" with icon caution
  return button returned of dialogResult
end run
APPLESCRIPT
)" || return 1
  [ "$result" == "$2" ]
}

repair_missing_files() {
  local required_path
  local required_paths=(install-wor.sh install-wor-gui.sh src/lib/metadata.sh src/lib/dependencies.sh src/lib/paths.sh src/lib/cleanup.sh config-templates assets/logo-full.png assets/partnership.png)
  local missing=()
  if git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1 ;then
    while IFS= read -r required_path ;do
      [ -n "$required_path" ] && required_paths+=("$required_path")
    done < <(git -C "$REPO_DIR" ls-tree -r --name-only HEAD -- config-templates)
  fi
  for required_path in "${required_paths[@]}" ;do
    [ -e "$REPO_DIR/$required_path" ] || missing+=("$required_path")
  done
  [ "${#missing[@]}" -gt 0 ] || return 0

  git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1 \
    || { show_error $'Required WoR-Flasher files are missing and this is not a Git checkout:\n\n'"${missing[*]}"; return 1; }
  for required_path in "${missing[@]}" ;do
    git -C "$REPO_DIR" cat-file -e "HEAD:$required_path" 2>/dev/null \
      || { show_error $'Required file cannot be repaired from the local checkout:\n\n'"$required_path"; return 1; }
  done
  ask_to_continue $'WoR-Flasher is missing required files:\n\n'"${missing[*]}"$'\n\nRestore only these files from the local Git revision?' Repair \
    || return 1
  git -C "$REPO_DIR" restore --source=HEAD -- "${missing[@]}" \
    || { show_error 'WoR-Flasher could not restore its missing files.'; return 1; }
}

check_for_update() {
  command -v git >/dev/null || return 0
  git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  [ -z "$(git -C "$REPO_DIR" status --porcelain --untracked-files=no)" ] || return 0

  local update_repository="${UPDATE_REPO_URL:-}"
  local update_ref="${UPDATE_REF:-}"
  local local_commit remote_commit remote_file remote_pid attempt
  [ -n "$update_repository" ] || update_repository="$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null)" || return 0
  [ -n "$update_ref" ] || update_ref="refs/heads/$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null)" || return 0
  local_commit="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null)" || return 0
  remote_file="$(mktemp "${TMPDIR:-/tmp}/wor-flasher-update.XXXXXX")" || return 0
  git ls-remote "$update_repository" "$update_ref" > "$remote_file" 2>/dev/null &
  remote_pid=$!
  for attempt in {1..80};do
    kill -0 "$remote_pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$remote_pid" 2>/dev/null ;then
    kill "$remote_pid" 2>/dev/null
  fi
  wait "$remote_pid" 2>/dev/null || true
  remote_commit="$(awk 'NR == 1 {print $1}' "$remote_file")"
  rm -f "$remote_file"
  [ -n "$remote_commit" ] && [ "$local_commit" != "$remote_commit" ] || return 0

  ask_to_continue $'A WoR-Flasher update is available.\n\nCurrent: '"${local_commit:0:12}"$'\nAvailable: '"${remote_commit:0:12}"$'\n\nUpdate this clean checkout before launching?' 'Update Now' \
    || return 0
  if ! git -C "$REPO_DIR" fetch --quiet "$update_repository" "$update_ref" \
    || ! git -C "$REPO_DIR" merge --ff-only FETCH_HEAD >/dev/null ;then
    show_error 'The update could not be applied safely. Your current checkout was not replaced.'
    return 1
  fi
}

prepare_dependencies() {
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  if ! command -v brew >/dev/null ;then
    ask_to_continue 'WoR-Flasher needs Homebrew to install its command-line dependencies. Open the official Homebrew website?' 'Open Homebrew' \
      && /usr/bin/open 'https://brew.sh'
    return 1
  fi

  local formula installed_formulae
  local missing=()
  installed_formulae="$(brew list --formula 2>/dev/null)" || installed_formulae=''
  for formula in "${WOR_MACOS_BREW_FORMULAE[@]}" ;do
    grep -Fxq "$formula" <<<"$installed_formulae" || missing+=("$formula")
  done
  [ "${#missing[@]}" -gt 0 ] || return 0

  ask_to_continue $'WoR-Flasher needs these Homebrew formulae:\n\n'"${missing[*]}"$'\n\nInstall only the missing dependencies now?' Install \
    || return 1
  export HOMEBREW_NO_AUTO_UPDATE=1
  local install_log="${TMPDIR:-/tmp}/wor-flasher-brew-install.log"
  if ! brew install "${missing[@]}" >"$install_log" 2>&1 ;then
    show_error "Homebrew could not install every dependency.\n\nLog: $install_log"
    return 1
  fi
  rm -f "$install_log"
}

launcher_main() {
  STARTUP_STATUS="$(mktemp "${TMPDIR:-/tmp}/wor-flasher-startup.XXXXXX")" || exit 1
  STARTUP_DONE="${STARTUP_STATUS}.done"
  trap cleanup_startup EXIT INT TERM
  startup_phase 'Checking application files...'
  start_startup_window

  if [ "$SOURCE_CHECKOUT" == 1 ];then
    repair_missing_files || exit 1
    load_metadata || { show_error 'WoR-Flasher metadata could not be loaded after repair.'; exit 1; }
    startup_phase 'Checking for a safe source update...'
    check_for_update || exit 1
    startup_phase 'Verifying updated files...'
    load_metadata || { show_error 'Updated WoR-Flasher metadata could not be loaded.'; exit 1; }
    startup_phase 'Synchronizing application resources...'
    sync_bundle_metadata || { show_error 'The updated macOS app metadata could not be synchronized.'; exit 1; }
  else
    startup_phase 'Preparing the verified runtime...'
    bootstrap_embedded_runtime || { show_error 'The embedded WoR-Flasher runtime could not be installed safely.'; exit 1; }
    select_runtime || { show_error 'The installed WoR-Flasher runtime could not be selected.'; exit 1; }
    load_metadata || { show_error 'Verified WoR-Flasher metadata could not be loaded.'; exit 1; }
    startup_phase 'Checking for a verified update...'
    check_for_runtime_update
    select_runtime || { show_error 'No verified WoR-Flasher runtime remains available.'; exit 1; }
    load_metadata || { show_error 'Verified WoR-Flasher metadata could not be loaded.'; exit 1; }
  fi
  startup_phase 'Checking required tools...'
  prepare_dependencies || exit 1

  [ -x "$GUI_SCRIPT" ] || { show_error $'The GUI is not executable:\n\n'"$GUI_SCRIPT"; exit 1; }
  startup_phase 'Opening the setup assistant...'
  stop_startup_window
  export NO_UPDATE=1
  export HOMEBREW_NO_AUTO_UPDATE=1
  export WOR_NATIVE_APP=1
  export WOR_CACHE_DIR="$APP_SUPPORT_DIR/cache"
  export WOR_ICON_PATH="$RESOURCES_DIR/$WOR_ICON_FILENAME"
  trap - EXIT INT TERM
  rm -f "$STARTUP_STATUS" "$STARTUP_DONE"
  exec "$GUI_SCRIPT"
}

if [ "${WOR_LAUNCHER_SOURCE_ONLY:-0}" != 1 ];then
  launcher_main
fi
