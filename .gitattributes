# Keep source and project metadata line endings consistent.
* text=auto eol=lf

*.sh text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.json text eol=lf
*.md text eol=lf

# Templates stay LF in Git; Rust stages the Windows command payloads with CRLF.
*.cmd text eol=lf

# Binary assets
*.png binary
*.exe binary

# Large generated SVGs produce unreadable diffs
*.svg -diff
